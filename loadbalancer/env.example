# Copy to .env (cp env.example .env) and set these for your server. No secrets go in here.
# OPENEVSE_SITE: the full path of the site folder (the one with index.php and openevse.db)
OPENEVSE_SITE=/var/www/html/openevse
# MQTT_BIND: this server's LAN address (the broker listens only there; never forward the port)
MQTT_BIND=192.168.1.10
# MQTT_PORT: the broker's port on that address (the units are set up to use it). Default 1883.
MQTT_PORT=1883
# RUN_UID / RUN_GID: the web server user's uid and gid (id -u www-data; id -g www-data)
RUN_UID=33
RUN_GID=33
# OEV_NAME: prefix for the Docker project and container names (default openevse:
# openevse-mosquitto, openevse-lb-coordinator). Change it only to run a second copy.
OEV_NAME=openevse
# LB_DRY_RUN: 1 = the load balancer only logs what it would do (start here), 0 = it sets
# the units' current. Blank = dry_run in coordinator/lb.ini (1, dry run). After a change: docker compose up -d
LB_DRY_RUN=1
